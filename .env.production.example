# Docker Compose production-like environment example.
# Copy to .env before running docker compose.

MYSQL_ROOT_PASSWORD=social_root_password
DATABASE_NAME=social
DATABASE_USER=social
DATABASE_PASSWORD=social_password
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=http://localhost:3000
SERVER_PORT=3000
ADMIN_PORT=8080
